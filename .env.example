# Base URL of the TeamBridge CRM app. Sign in / Get started CTAs link to
# `${VITE_APP_URL}${VITE_SIGN_IN_PATH}` and `${VITE_APP_URL}${VITE_SIGN_UP_PATH}`.
# Leave VITE_APP_URL empty when the landing page is served from the same origin as the CRM.
VITE_APP_URL=
VITE_SIGN_IN_PATH=/login
VITE_SIGN_UP_PATH=/register

# Demo requests: POST JSON to this endpoint (optional)
VITE_DEMO_ENDPOINT=
# Sales inbox used as a mailto fallback for demo requests (optional)
VITE_SALES_EMAIL=

# Plan checkout (optional). Both receive the visitor's details and plan choice as JSON (POST).
# Trial endpoint may return { redirectUrl }; checkout endpoint must return { url } of the
# payment provider's hosted checkout page (for example a Razorpay or Stripe session).
VITE_TRIAL_ENDPOINT=
VITE_CHECKOUT_ENDPOINT=
# Test-mode payment screens (simulated, no real payment). Always on with npm run dev;
# set to true to keep them in a production build, e.g. for a staging demo.
VITE_PAYMENT_MOCK=

# Policy pages are built in (/privacy/, /terms/, /cancellation-policy/).
# Set these only to send the links to pages hosted elsewhere.
VITE_PRIVACY_URL=
VITE_TERMS_URL=
VITE_CANCELLATION_URL=

# Business details shown in the policies (each one shows a highlighted gap until set)
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_GRIEVANCE_OFFICER=
VITE_GRIEVANCE_EMAIL=
VITE_LEGAL_JURISDICTION=
